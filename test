apiVersion: v1
kind: Secret
metadata:
  name: postgres-secrets
  namespace: group-10
type: Opaque
stringData:
  CATALOGUE_DB: catalogue_db
  CATALOGUE_USER: catalogue_user
  CATALOGUE_PASSWORD: catalogue_pass
  BOOKING_DB: booking_db
  BOOKING_USER: booking_user
  BOOKING_PASSWORD: booking_pass
---
apiVersion: v1
kind: Secret
metadata:
  name: rabbitmq-secrets
  namespace: group-10
type: Opaque
stringData:
  RABBITMQ_DEFAULT_USER: guest
  RABBITMQ_DEFAULT_PASS: guest
  RABBIT_USER: guest
  RABBIT_PASSWORD: guest
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: catalogue-pgdata
  namespace: group-10
spec:
  storageClassName: csi-cinder-fast
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 5Gi
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: booking-pgdata
  namespace: group-10
spec:
  storageClassName: csi-cinder-fast
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 5Gi

# -------------------------
# catalogue-postgres
# -------------------------
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: catalogue-postgres
  namespace: group-10
spec:
  replicas: 1
  selector:
    matchLabels:
      app: catalogue-postgres
  template:
    metadata:
      labels:
        app: catalogue-postgres
    spec:
      containers:
        - name: postgres
          image: postgres:16
          ports:
            - containerPort: 5432
          env:
            - name: POSTGRES_DB
              valueFrom:
                secretKeyRef:
                  name: postgres-secrets
                  key: CATALOGUE_DB
            - name: POSTGRES_USER
              valueFrom:
                secretKeyRef:
                  name: postgres-secrets
                  key: CATALOGUE_USER
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-secrets
                  key: CATALOGUE_PASSWORD
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
          volumeMounts:
            - name: pgdata
              mountPath: /var/lib/postgresql/data
          readinessProbe:
            tcpSocket:
              port: 5432
            initialDelaySeconds: 10
            periodSeconds: 5
          livenessProbe:
            tcpSocket:
              port: 5432
            initialDelaySeconds: 20
            periodSeconds: 10
      volumes:
        - name: pgdata
          persistentVolumeClaim:
            claimName: catalogue-pgdata
---
apiVersion: v1
kind: Service
metadata:
  name: catalogue-postgres
  namespace: group-10
spec:
  selector:
    app: catalogue-postgres
  ports:
    - port: 5432
      targetPort: 5432

